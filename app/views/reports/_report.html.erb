<div id="<%= dom_id report %>">
  <% user = User.find(report.user_id) %>
  <p>
    <% if user.name.empty? %>
      <strong><%= User.human_attribute_name(:email) %>:</strong>
      <%= user.email %>
    <% else %>
      <strong><%= User.human_attribute_name(:name) %>:</strong>
      <%= user.name %>
    <% end %>
  </p>

  <p>
    <strong><%= Report.human_attribute_name(:created_at) %>:</strong>
    <%= report.created_at.strftime('%Y/%m/%d %H:%M') %>
  </p>

  <p>
    <strong><%= Report.human_attribute_name(:title) %>:</strong>
    <%= report.title %>
  </p>

  <p>
    <strong><%= Report.human_attribute_name(:text) %>:</strong>
    <div class="profile_body"><%= report.text %></div>
  </p>

</div>
